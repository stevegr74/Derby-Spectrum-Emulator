<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Derby</AssemblyName>
    <RootNamespace>Derby</RootNamespace>
    <Product>DERBY - ZX Spectrum 48K / 128K Emulator</Product>
    <AssemblyTitle>DERBY</AssemblyTitle>
    <Description>A focused ZX Spectrum 48K and 128K emulator.</Description>
    <ApplicationIcon>assets\branding\derby.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="assets\branding\derby-mark.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ROMs\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Pokes\pokes.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Derby.Core\Derby.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="obj\**\*.cs" />
    <Compile Remove="bin\**\*.cs" />
    <Compile Remove="tmp\**\*.cs" />
    <Compile Remove="Derby.Tests\**\*.cs" />
    <Compile Remove="Derby.Windows.Tests\**\*.cs" />
    <Compile Remove="Derby.ManualHarness\**\*.cs" />
	<Compile Remove="Derby.Z80Compliance\**\*.cs" />
    <Compile Remove="Derby.Core\**\*.cs" />
    <EmbeddedResource Remove="obj\**\*" />
    <EmbeddedResource Remove="bin\**\*" />
    <EmbeddedResource Remove="tmp\**\*" />
    <None Remove="obj\**\*" />
    <None Remove="bin\**\*" />
    <None Remove="tmp\**\*" />
    <EmbeddedResource Remove="Derby.Tests\**\*" />
    <EmbeddedResource Remove="Derby.Windows.Tests\**\*" />
    <EmbeddedResource Remove="Derby.ManualHarness\**\*" />
	<EmbeddedResource Remove="Derby.Z80Compliance\**\*" />
	<EmbeddedResource Remove="Derby.Core\**\*" />
    <None Remove="Derby.Tests\**\*" />
    <None Remove="Derby.Windows.Tests\**\*" />
    <None Remove="Derby.ManualHarness\**\*" />
	<None Remove="Derby.Z80Compliance\**\*" />
	<None Remove="Derby.Core\**\*" />
  </ItemGroup>

</Project>
